generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  STAFF
  VIEWER
}
enum Marketplace {
  SHOPIFY
  EBAY
  AMAZON
  FLIPKART
}
enum StoreStatus {
  CONNECTED
  ACTION_REQUIRED
  DISCONNECTED
}
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}
enum ListingStatus {
  DRAFT
  QUEUED
  PUBLISHING
  PUBLISHED
  FAILED
}
enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}
enum OrderStatus {
  UNFULFILLED
  PROCESSING
  FULFILLED
  CANCELLED
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  name         String
  passwordHash String
  memberships  Membership[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Organization {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  plan      String       @default("GROWTH")
  members   Membership[]
  stores    Store[]
  products  Product[]
  orders    Order[]
  jobs      PublishJob[]
  audits    AuditLog[]
  serviceRequests ServiceRequest[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Membership {
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  role           Role         @default(STAFF)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@id([userId, organizationId])
}

model Store {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @db.Uuid
  marketplace          Marketplace
  name                 String
  externalAccountId    String?
  status               StoreStatus  @default(DISCONNECTED)
  encryptedCredentials String?
  settings             Json?
  lastSyncAt            DateTime?
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listings             Listing[]
  orders               Order[]
  jobs                 PublishJob[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  @@unique([marketplace, externalAccountId])
  @@index([organizationId, status])
}

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  name           String
  sku            String
  description    String
  brand          String?
  category       String
  price          Decimal       @db.Decimal(12, 2)
  compareAtPrice Decimal?      @db.Decimal(12, 2)
  stock          Int           @default(0)
  status         ProductStatus @default(DRAFT)
  attributes     Json?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  images         ProductImage[]
  listings       Listing[]
  jobs           PublishJob[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  @@unique([organizationId, sku])
  @@index([organizationId, status])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  objectKey String   @unique
  mimeType  String
  size      Int
  position  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Listing {
  id           String        @id @default(uuid()) @db.Uuid
  productId    String        @db.Uuid
  storeId      String        @db.Uuid
  externalId   String?
  status       ListingStatus @default(DRAFT)
  errorCode    String?
  errorMessage String?
  publishedAt  DateTime?
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  @@unique([productId, storeId])
  @@index([storeId, status])
}

model PublishJob {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  productId      String       @db.Uuid
  storeId        String       @db.Uuid
  bullJobId      String?      @unique
  status         JobStatus    @default(QUEUED)
  attempt        Int          @default(0)
  errorMessage   String?
  result         Json?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@index([organizationId, status, createdAt])
}

model Order {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  storeId        String       @db.Uuid
  externalId     String
  status         OrderStatus  @default(UNFULFILLED)
  customerName   String
  total          Decimal      @db.Decimal(12, 2)
  currency       String       @default("INR")
  orderedAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@unique([storeId, externalId])
  @@index([organizationId, status, orderedAt])
}

model WebhookEvent {
  id          String      @id @default(uuid()) @db.Uuid
  marketplace Marketplace
  externalId  String
  topic       String
  receivedAt  DateTime    @default(now())
  processedAt DateTime?
  @@unique([marketplace, externalId])
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String?      @db.Uuid
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  @@index([organizationId, createdAt])
}

model ServiceRequest {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  createdById    String @db.Uuid
  service        String
  title          String
  brief          String
  marketplace    String
  quantity       Int @default(1)
  status         String @default("SUBMITTED")
  assigneeId     String? @db.Uuid
  revision       Int @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updates        ServiceUpdate[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([organizationId, createdAt])
}

model ServiceUpdate {
  id        String @id @default(uuid()) @db.Uuid
  requestId String @db.Uuid
  authorId  String @db.Uuid
  body      String
  status    String
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([requestId, createdAt])
}
